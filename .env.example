# Copy to .env and change before running anywhere but your own machine.

# Starts the bundled PostgreSQL container. Remove it to use your own database instead.
COMPOSE_PROFILES=postgres
# Your own database. Leave unset to use the bundled container.
# From inside a container, reach PostgreSQL on the host as host.docker.internal, not localhost.
# APIM_DB_CONNECTION=Host=host.docker.internal;Database=apim;Username=apim;Password=change-me

POSTGRES_PASSWORD=apim-dev-password
