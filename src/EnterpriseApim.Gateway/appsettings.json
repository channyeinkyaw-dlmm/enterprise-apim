{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "ConfigRefreshSeconds": 60,
    "KeyCacheSeconds": 120,
    "AnonymousRateLimitPerMinute": 120,
    "UsageFlushSeconds": 60,
    "KnownProxies": []
  }
}
